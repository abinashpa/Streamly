# ==========================================
# Streamly Global Environment Variables
# ==========================================

# PostgreSQL
POSTGRES_USER=streamly
POSTGRES_PASSWORD=streamly_password
POSTGRES_DB=streamly
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Apache Kafka
KAFKA_PORT=9092
KAFKA_BROKERS=kafka:9092

# OpenSearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin

# JWT
JWT_SECRET=streamly-super-secret-jwt-key-2026

# Ports
API_GATEWAY_PORT=8080
MEDIA_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082
SEARCH_SERVICE_PORT=8083
USER_SERVICE_PORT=8084
GRAPHQL_SERVICE_PORT=8085
FRONTEND_PORT=3000

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
API_GATEWAY_URL=http://api-gateway:8080
DATABASE_URL=postgresql://streamly:streamly_password@postgres:5432/streamly_frontend
